<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>انتخاب بازی PS5</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@500;600;700&family=Vazirmatn:wght@400;600;800&display=swap">
<style>
:root{--bg:#e9edf6;--surface:#fff;--ink:#0d1526;--muted:#5b6578;--line:#d3d9e6;--accent:#1747e6;--accent-ink:#fff;--accent-soft:#e1e9ff;--ok:#0b8a5e;--warn:#b36a00;--bad:#c9302c;--track:#dde3ef;
--act:#2f6bff;--rpg:#a24bff;--shoot:#ff8a1f;--horror:#e0334f;--sport:#10b981;--fight:#ec4899;--fam:#14b8d4;
--sans:"Vazirmatn",Tahoma,system-ui,sans-serif;--latin:"Barlow","Vazirmatn",system-ui,sans-serif;color-scheme:light dark}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#070b14;--surface:#101827;--ink:#e8edf7;--muted:#93a0b8;--line:#223049;--accent:#6a96ff;--accent-ink:#071022;--accent-soft:#16254d;--ok:#34d399;--warn:#f5b53d;--bad:#ff7b7b;--track:#1b2740;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#070b14;--surface:#101827;--ink:#e8edf7;--muted:#93a0b8;--line:#223049;--accent:#6a96ff;--accent-ink:#071022;--accent-soft:#16254d;--ok:#34d399;--warn:#f5b53d;--bad:#ff7b7b;--track:#1b2740;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 var(--sans);-webkit-text-size-adjust:100%}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:#070b14;z-index:30}
button,input,select{font:inherit;color:inherit}
.inner{max-width:760px;margin:0 auto;padding-inline:max(16px,env(safe-area-inset-left,0px)) max(16px,env(safe-area-inset-right,0px))}
/* hero */
.hero{position:relative;overflow:hidden;color:#fff;background:radial-gradient(120% 90% at 85% 0%,#2d4fff 0%,transparent 55%),radial-gradient(90% 80% at 0% 100%,#a24bff 0%,transparent 55%),#070b14;padding-top:calc(env(safe-area-inset-top,0px) + 34px);padding-bottom:30px}
.hero::after{content:"";position:absolute;inset:0;background:repeating-linear-gradient(115deg,rgba(255,255,255,.04) 0 1px,transparent 1px 26px);pointer-events:none}
.sym{position:absolute;width:var(--s);height:var(--s);left:var(--x);top:var(--y);opacity:.22;animation:drift 14s ease-in-out infinite alternate;animation-delay:var(--d)}
.sym svg{width:100%;height:100%;fill:none;stroke:currentColor;stroke-width:3;stroke-linejoin:round;stroke-linecap:round}
@keyframes drift{from{transform:translateY(0) rotate(0)}to{transform:translateY(-22px) rotate(25deg)}}
.hero .inner{position:relative;z-index:2}
.hero h1{font-size:clamp(30px,8vw,48px);font-weight:800;line-height:1.2;margin:0 0 8px;text-wrap:balance;text-shadow:0 4px 30px rgba(23,71,230,.6)}
.hero p{margin:0 0 18px;color:#c4cee6;max-width:46ch}
.stats{display:flex;gap:10px;flex-wrap:wrap}
.stat{padding:8px 14px;border:1px solid rgba(255,255,255,.2);background:rgba(255,255,255,.08);backdrop-filter:blur(6px);border-radius:12px}
.stat b{display:block;font:700 22px/1.1 var(--latin);font-variant-numeric:tabular-nums}
.stat span{font-size:12px;color:#c4cee6}
/* band */
.band{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--surface);border-bottom:1px solid var(--line);box-shadow:0 8px 24px -16px rgba(0,0,0,.5)}
.band .inner{padding-block:10px}
.g{display:flex;align-items:center;gap:14px}
.ring{position:relative;width:84px;height:84px;flex:none}
.ring svg{width:100%;height:100%;transform:rotate(-90deg) scaleY(-1)}
.ring circle{fill:none;stroke-width:9}
.ring .bgc{stroke:var(--track)}
.ring .fg{stroke:var(--accent);stroke-linecap:round;stroke-dasharray:213.6;stroke-dashoffset:213.6;transition:stroke-dashoffset .5s cubic-bezier(.2,.8,.2,1),stroke .2s}
.ring .fg.warn{stroke:var(--warn)}.ring .fg.bad{stroke:var(--bad)}
.ring .pc{position:absolute;inset:0;display:grid;place-items:center;font:700 19px var(--latin);font-variant-numeric:tabular-nums}
.gm{flex:1;min-width:0}
.lbl{display:block;font-size:12px;color:var(--muted)}
.rem{font:700 32px/1 var(--latin);font-variant-numeric:tabular-nums}
.rem small{font-size:13px;font-weight:600;color:var(--muted);margin-inline-start:4px}
.usedtxt{font-size:12.5px;color:var(--muted)}
.usedtxt b{font-family:var(--latin);color:var(--ink)}
.stack{display:flex;height:10px;margin-top:9px;background:var(--track);border-radius:6px;overflow:hidden}
.stack i{display:block;height:100%;transition:width .4s ease;min-width:0}
.msg{min-height:20px;font-size:13px;margin-top:5px;color:var(--muted)}
.msg.warn{color:var(--warn)}.msg.bad{color:var(--bad);font-weight:600}
.band.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.tabs{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:3px;background:var(--bg);border-radius:10px;margin-top:4px}
.tab{border:0;background:transparent;padding:7px;border-radius:8px;font-weight:600;font-size:14px;color:var(--muted);cursor:pointer}
.tab[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:0 0 0 1px var(--line)}
.tab .n{font-family:var(--latin)}
/* controls */
main .inner{padding-block:16px 40px}
.search{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.chips{display:flex;gap:6px;overflow-x:auto;padding-block:10px 4px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;display:flex;align-items:center;gap:6px;border:1px solid var(--line);background:var(--surface);padding:5px 12px;border-radius:999px;font-size:13px;cursor:pointer;white-space:nowrap}
.chip i{width:9px;height:9px;border-radius:50%;background:var(--c,var(--muted))}
.chip[aria-pressed="true"]{background:var(--c,var(--accent));border-color:var(--c,var(--accent));color:#fff;font-weight:600}
.chip[aria-pressed="true"] i{background:#fff}
.meta{display:flex;justify-content:space-between;align-items:center;margin-block:8px 6px;font-size:13px;color:var(--muted)}
.sort{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:4px 8px;font-size:13px}
/* list */
ul.list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.row{position:relative;display:grid;grid-template-columns:58px 1fr auto;align-items:center;gap:12px;padding:8px 10px;background:var(--surface);border:1px solid var(--line);border-radius:14px;cursor:pointer;overflow:hidden;transition:transform .15s,border-color .15s}
.row:active{transform:scale(.985)}
.row input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.cover{position:relative;width:58px;height:58px;border-radius:12px;overflow:hidden;display:grid;place-items:center;color:#fff;font:700 20px var(--latin);background:linear-gradient(140deg,hsl(var(--h) 80% 52%),hsl(calc(var(--h) + 45) 75% 22%));box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}
.cover svg{position:absolute;width:150%;height:150%;inset:-25%;margin:auto;opacity:.18;fill:none;stroke:#fff;stroke-width:3}
.cover span{position:relative;text-shadow:0 2px 8px rgba(0,0,0,.5)}
.cover .ck{position:absolute;inset:0;display:grid;place-items:center;background:rgba(7,11,20,.55);opacity:0;transition:opacity .15s}
.cover .ck::after{content:"";width:22px;height:11px;border-left:4px solid #fff;border-bottom:4px solid #fff;transform:rotate(-45deg) translate(1px,-3px)}
.row:has(input:checked){border-color:var(--c);background:linear-gradient(90deg,transparent,var(--accent-soft));box-shadow:0 0 0 1px var(--c),0 8px 22px -12px var(--c)}
.row:has(input:checked) .ck{opacity:1}
.row:has(input:focus-visible){outline:2px solid var(--accent);outline-offset:2px}
.name{min-width:0}
.name .t{display:block;font:600 16px/1.3 var(--latin);overflow-wrap:anywhere;direction:ltr;text-align:right}
.name .s{display:flex;flex-wrap:wrap;gap:2px 8px;font-size:12px;color:var(--muted);margin-top:3px}
.gen{color:var(--c);font-weight:600}
.tag{color:var(--warn);font-weight:600}.tag.no{color:var(--bad)}
.sz{text-align:left;direction:ltr;min-width:66px}
.sz b{display:block;font:700 18px/1.2 var(--latin);font-variant-numeric:tabular-nums}
.sz span{display:block;font:11px var(--latin);color:var(--muted)}
.share{height:4px;background:var(--track);border-radius:2px;margin-top:4px;overflow:hidden}
.share i{display:block;height:100%;background:var(--c);border-radius:2px}
.row.nofit:not(:has(input:checked)){opacity:.5}
.empty{padding:28px 16px;text-align:center;color:var(--muted);background:var(--surface);border:1px dashed var(--line);border-radius:14px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.btn{border:1px solid var(--line);background:var(--surface);padding:10px 16px;border-radius:12px;font-weight:600;cursor:pointer}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.notes{margin-top:26px;padding-top:14px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted);display:flex;flex-direction:column;gap:6px}
.notes a{color:var(--accent)}
.notes p{margin:0}
.hbtns{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px}
.admbtn{border:1px solid rgba(255,255,255,.3);background:rgba(255,255,255,.1);color:#fff;border-radius:999px;padding:6px 14px;font-size:13px;cursor:pointer;backdrop-filter:blur(6px)}
.cloudst{font-size:12px;color:#c4cee6}
.modal{position:fixed;inset:0;z-index:50;display:grid;place-items:center;background:rgba(7,11,20,.8);backdrop-filter:blur(8px);padding:max(16px,env(safe-area-inset-top,0px)) 16px max(16px,env(safe-area-inset-bottom,0px))}
.modal[hidden]{display:none}
.mcard{width:100%;max-width:420px;max-height:88vh;overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 30px 80px -20px rgba(23,71,230,.6)}
.mcard h2{margin:0 0 6px;font-size:21px;font-weight:800}
.mcard p{margin:0 0 14px;color:var(--muted);font-size:14px}
.mcard .btn{margin-top:10px;width:100%}
.mcard .btn.ghost{background:transparent}
.err{color:var(--bad);font-size:13px;margin-top:8px;min-height:18px}
.pl{border:1px solid var(--line);border-radius:12px;margin-top:8px;background:var(--bg)}
.pl summary{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 12px;cursor:pointer;list-style:none}
.pl summary::-webkit-details-marker{display:none}
.pl .pn{font-weight:700}
.pl .pm{font:12px var(--latin);color:var(--muted);text-align:left;direction:ltr}
.pl ul{margin:0;padding:0 12px 12px;list-style:none;font:13px/1.8 var(--latin);direction:ltr}
.pl li{display:flex;justify-content:space-between;gap:8px;border-top:1px solid var(--line)}
.pl li span:last-child{color:var(--muted)}
@media (prefers-reduced-motion:reduce){.sym,.band.shake{animation:none}.ring .fg,.stack i{transition:none}}
</style>
</head>
<body>
<header class="hero" aria-label="معرفی">
  <div class="sym" style="--s:70px;--x:6%;--y:18%;--d:0s;color:#6a96ff"><svg viewBox="0 0 40 40"><path d="M20 6 35 33H5z"/></svg></div>
  <div class="sym" style="--s:54px;--x:78%;--y:12%;--d:-4s;color:#ff6b8a"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="14"/></svg></div>
  <div class="sym" style="--s:60px;--x:88%;--y:62%;--d:-7s;color:#5ee0b0"><svg viewBox="0 0 40 40"><path d="M8 8 32 32M32 8 8 32"/></svg></div>
  <div class="sym" style="--s:48px;--x:40%;--y:70%;--d:-2s;color:#f5b0ff"><svg viewBox="0 0 40 40"><rect x="7" y="7" width="26" height="26" rx="2"/></svg></div>
  <div class="inner">
    <h1>کتابخانه‌ی PS5 خودت را بچین</h1>
    <p>بازی‌ها را انتخاب کن و ببین ۷۶۰ گیگ حافظه چطور پر می‌شود.</p>
    <div class="stats"><div class="stat"><b id="hN">0</b><span>بازی در فهرست</span></div><div class="stat"><b id="hT">0</b><span>بازی موجود</span></div><div class="stat"><b>760 GB</b><span>ظرفیت</span></div></div>
    <div class="hbtns"><button class="admbtn" id="nameBtn"></button><button class="admbtn" id="admOpen">بخش ادمین</button><span class="cloudst" id="cloud"></span></div>
  </div>
</header>
<div class="band" id="band">
  <div class="inner">
    <div class="g">
      <div class="ring"><svg viewBox="0 0 80 80"><circle class="bgc" cx="40" cy="40" r="34"/><circle class="fg" id="fill" cx="40" cy="40" r="34"/></svg><div class="pc"><span id="pc">0%</span></div></div>
      <div class="gm">
        <span class="lbl">فضای باقی‌مانده</span>
        <div class="rem"><span id="rem">760</span><small>GB</small></div>
        <div class="usedtxt">پر شده <b id="used">0</b> از <b>760</b> GB</div>
      </div>
    </div>
    <div class="stack" id="stack" role="img" aria-label="سهم هر ژانر از حافظه"></div>
    <div class="msg" id="msg" aria-live="polite"></div>
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" id="tab-all" aria-selected="true">همه بازی‌ها</button>
      <button class="tab" role="tab" id="tab-sel" aria-selected="false">انتخاب‌شده‌ها <span class="n" id="cnt">0</span></button>
    </div>
  </div>
</div>
<main><div class="inner">
  <input class="search" id="q" type="search" placeholder="جستجوی نام بازی، مثلا God یا Spider" autocomplete="off" enterkeyhint="search">
  <div class="chips" id="chips"></div>
  <div class="meta"><span id="count"></span>
    <select class="sort" id="sort" aria-label="مرتب‌سازی"><option value="big">حجم: زیاد به کم</option><option value="small">حجم: کم به زیاد</option><option value="name">نام: A تا Z</option></select></div>
  <ul class="list" id="list"></ul>
  <div class="actions" id="actions" hidden><button class="btn primary" id="copy">کپی لیست</button><button class="btn" id="clear">پاک کردن همه</button></div>
  <div class="notes">
    <p>حجم‌ها از فهرست‌های منتشرشده گرفته شده (<a href="https://outsidergaming.com/playstation-game-install-sizes-reference-guide/" target="_blank" rel="noopener">Outsider Gaming</a>، <a href="https://gamerant.com/ps5-biggest-game-file-sizes-gb/" target="_blank" rel="noopener">GameRant</a>، <a href="https://www.gamesradar.com/ps5-install-sizes/" target="_blank" rel="noopener">GamesRadar</a>، <a href="https://www.notebookcheck.net/Resident-Evil-Requiem-is-largest-game-in-series-as-PS5-file-size-and-pre-load-date-leak.1226855.0.html" target="_blank" rel="noopener">Notebookcheck</a>). با آپدیت و DLC تغییر می‌کنند.</p>
    <p>بازی‌های علامت‌دار «تقریبی» یا «تخمینی» دقیق نیستند؛ قبل از دانلود حجم را در PlayStation Store ببین. این صفحه حدود ۱۵۰ بازی پرطرفدار دارد، نه همه‌ی عنوان‌های PS5.</p>
    <p>منابع بخش جدید: <a href="https://insider-gaming.com/" target="_blank" rel="noopener">Insider Gaming</a>، <a href="https://www.pushsquare.com/" target="_blank" rel="noopener">Push Square</a>، <a href="https://www.sportskeeda.com/" target="_blank" rel="noopener">Sportskeeda</a>، <a href="https://www.thegamer.com/" target="_blank" rel="noopener">TheGamer</a>، <a href="https://www.ggrecon.com/" target="_blank" rel="noopener">GGRecon</a>، <a href="https://mp1st.com/" target="_blank" rel="noopener">MP1st</a> و <a href="https://psprices.com/" target="_blank" rel="noopener">PSprices</a>.</p>
  </div>
</div></main>
<div class="modal" id="nameModal" hidden><div class="mcard" role="dialog" aria-labelledby="nmT"><h2 id="nmT">اسمت چیه؟</h2><p>قبل از شروع یک اسم وارد کن تا انتخاب‌هایت ذخیره شود.</p><input class="search" id="nameIn" maxlength="30" placeholder="مثلا علی" autocomplete="nickname" enterkeyhint="done"><button class="btn primary" id="nameOk">ذخیره و ادامه</button></div></div>
<div class="modal" id="admModal" hidden><div class="mcard" role="dialog" aria-labelledby="amT"><h2 id="amT">بخش ادمین</h2>
<div id="admLock"><p>کد ادمین را وارد کن.</p><input class="search" id="admCode" type="password" inputmode="numeric" maxlength="8" placeholder="کد" autocomplete="off"><div class="err" id="admErr"></div><button class="btn primary" id="admGo">ورود</button></div>
<div id="admBody" hidden><p id="admSum"></p><div id="admList"></div></div>
<button class="btn ghost" id="admClose">بستن</button></div></div>
